{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["src"],
  "pylint.importStrategy": "fromEnvironment",
  "pylint.args": [
    "--extension-pkg-allow-list=PyQt6,sounddevice",
    "--disable=missing-module-docstring,missing-class-docstring,missing-function-docstring,invalid-name,import-outside-toplevel,broad-exception-caught"
  ]
}
